# LangSmith — tracing and observability
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=knowledge-tree
# Non-US region? Uncomment your endpoint (else your API key won't authenticate):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC

# Model provider API keys — set the one you're using
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_API_KEY=your-google-api-key

# Kimi: for trying the Kimi hosted API 
# Get a free key at https://platform.moonshot.cn
# KIMI_API_KEY=sk-...

# DeepSeek: for trying the DeepSeek hosted API 
# Get a free key at https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-...

# OpenRouter: for trying free hosted open-source models 
# Get a free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...